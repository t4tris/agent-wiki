# --- Состояние Obsidian -------------------------------------------------------
# Локально для машины, в истории только засоряет диффы: workspace — открытые вкладки
# и раскладка панелей (7 правок), graph — вид графа с плавающим centerStrength (3 правки
# по одной строке). В индексе остаётся конфигурация: app.json, appearance.json, core-plugins.json.
#
# ВАЖНО: шаблон с косой чертой якорится к каталогу файла `.gitignore`, поэтому запись
# `.obsidian/workspace*.json` (без ведущего пути) к `wiki/.obsidian/` не применялась вовсе —
# проверка выглядела существующей, но не срабатывала. Пути указываются целиком.
# И помните: шаблон не убирает файл из индекса — уже отслеживаемый снимается `git rm --cached`.
wiki/.obsidian/workspace.json
# backlink.json — кэш ядрового плагина обратных ссылок: пишется при каждом просмотре
wiki/.obsidian/backlink.json
wiki/.obsidian/workspace-mobile.json
wiki/.obsidian/graph.json
wiki/.obsidian/cache

# Защита от мусора: если папку проекта случайно откроют как хранилище Obsidian, конфиг не попадёт в git.
# Ведущая косая черта обязательна: без неё шаблон накрыл бы и `wiki/.obsidian/`, а там живёт
# конфигурация, которую мы намеренно версионируем (app.json, appearance.json, core-plugins.json).
/.obsidian/

# --- Прочее -------------------------------------------------------------------
__pycache__/
*.pyc
.firecrawl/
*.log

# Секреты сессии и ключи: на публичной выкладке механизма им не место.
.env
.env.*
*.pem
*.key

# --- Рабочие выгрузки Telegram -------------------------------------------------
# Решение владельца 2026-09-14 (подтверждено): сырьё, медиа и личные документы
# переписки из проекта не публикуются вовсе. Папка исключена целиком; производные
# слои остаются работать на диске, но в копию не идут — версионируемое знание живёт
# в `raw/` (мастер) и `wiki/sources/raw/` (зеркало для чтения).
#
# ВАЖНО: исключение само по себе ничего не удаляет — отслеживаемое снимается
# `git rm -r --cached _staging/telegram`. Границу сторожит линтер (§39), потому что
# ровно на этом месте уже был дефект: решение записали, шаблон не добавили, 89 МБ
# и личные документы уехали в копию.
_staging/telegram/
/.venv/
/.venv-asr/
_tools/tg-saved/.venv/
_tools/tg-saved/models/
_tools/tg-saved/export/

# машинная сводка линтера: пересоздаётся каждым прогоном, в коммиты не идёт
# Машинные сводки линтера и замеров стиля: файл, покрытый .gitignore, но добавленный в git раньше правила,
# остаётся отслеживаемым — .gitignore действует только на неотслеживаемые. Пять таких файлов (lint-summary
# 09-11…09-14 и style-audit 09-16) сняты с отслеживания `git rm --cached` 2026-09-21 и лежат только локально.
_staging/audit/lint-summary-*.json
# пакеты волн для смыслового прохода: производное, пересобирается tree_bundle.py (манифест остаётся в git)
_staging/audit/bundle/wave-*.md
# журнал самопроверки правил — доказательство работы хука, в истории нужен (правило «один писатель» и §59)
!_staging/rules-check.log

# --- Медиа переписки, которого в репозитории быть не должно ---------------------
# Голосовые сообщения — не читаемый материал и не источник вики: расшифровка живёт текстом
# (`_staging/telegram/**/stt`, `_tools/tg-saved/export/`), а сам звук остаётся у владельца на диске.
# 10 файлов и 21 МБ попали в коммит 16bc042 через `git add -A`; из истории локально они остаются,
# но в удалённую копию не уходили. Шаблон не убирает уже отслеживаемый файл — отсюда `git rm --cached`.
/raw/telegram/voice_messages/

# Машинные дампы замера стиля: 177 тыс. строк сырых срабатываний, воспроизводятся прогоном
_staging/audit/style-audit-*.json

# Карта адресов из выгрузки Telegram (id сообщения -> адрес) лежит в репозитории:
# `_tools/tg-saved/links-by-message.json`. Отрицание внутри исключённого каталога git не понимает
# («It is not possible to re-include a file if a parent directory of that file is excluded»), поэтому
# карта вынесена из рабочей выгрузки, а не возвращена в неё.

# --- Внутренняя кухня: в поставку не уходит ----------------------------------
# Архив — отработавшие планы, промпты и разовые выходы проходов. Решение владельца 2026-09-21: «архив должен
# быть в .gitignore целиком. это моя внутренняя кухня, и пусть она остается на моем PC локально».
_staging/archive/
# Рабочая папка агента: черновики на время задачи, правило жизни — ничего не переживает сессию.
_staging/temp/

# Замок волны — среда исполнения, а не содержимое: держит, кто из детей какую страницу занял
_staging/wave-lock.json
# Фикстура для пробы: чужой корпус, он не наш и в поставку не идёт
_staging/tests/fixture/

# Реестр долга — под контролем версий и едет в поставку файлом debt.tsv (решение владельца 2026-09-26:
# открытый проект, пользователь должен знать долг; отменяет решение 2026-09-22 в обеих частях).
# Строку исключения не возвращать.

# Замыслы раскладки экземпляра: их ведёт владелец, поставка их не несёт.
_staging/map-intents.local.tsv

# Объявления и локальный канон экземпляра: их ведёт владелец вики, поставка их не несёт.
SCHEMA.local.md
_staging/domain.local.tsv
_staging/contract-v1.local.json
_staging/owner-markup.local.json
# Настройка агентской сессии на этой машине (прокси, счёт провайдера, проверка входа): ведёт машина,
# в поставку не идёт — как прочие объявления экземпляра.
_staging/opencode.local.md
_staging/report_groups.local.py
